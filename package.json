{
  "name": "vscode-html-wysiwyg",
  "displayName": "HTML WYSIWYG Editor",
  "description": "محرر HTML مرئي بسيط وسريع مع تزامن ثنائي الاتجاه",
  "publisher": "muataz",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/muataz/vscode-html-wysiwyg"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wysiwyg.open",
        "title": "WYSIWYG: Open HTML Visual Editor"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --outfile=dist/extension.js --external:vscode --format=cjs",
    "watch": "npm run build -- --watch",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.6.3"
  }
}
