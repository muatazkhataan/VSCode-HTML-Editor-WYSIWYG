{
  "name": "vscode-html-wysiwyg",
  "displayName": "HTML WYSIWYG Editor",
  "description": "محرر HTML مرئي بسيط وسريع مع تزامن ثنائي الاتجاه ودعم CSS الخارجي",
  "publisher": "Courras",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/muataz/vscode-html-wysiwyg"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "contributes": {
    "commands": [
      {
        "command": "wysiwyg.open",
        "title": "WYSIWYG: Open HTML Visual Editor",
        "icon": {
          "light": "resources/icon-light.svg",
          "dark": "resources/icon-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "wysiwyg.open",
          "when": "resourceLangId == html",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "wysiwyg.open",
        "key": "ctrl+shift+v",
        "when": "resourceLangId == html"
      },
      {
        "command": "-workbench.action.toggleSidebarVisibility",
        "key": "ctrl+b",
        "when": "activeWebviewPanelId == 'htmlWysiwyg'"
      },
      {
        "command": "-workbench.action.terminal.toggleTerminal",
        "key": "ctrl+`",
        "when": "activeWebviewPanelId == 'htmlWysiwyg'"
      },
      {
        "command": "-workbench.action.quickOpen",
        "key": "ctrl+p",
        "when": "activeWebviewPanelId == 'htmlWysiwyg'"
      },
      {
        "command": "-editor.action.commentLine",
        "key": "ctrl+/",
        "when": "activeWebviewPanelId == 'htmlWysiwyg'"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --outfile=dist/extension.js --external:vscode --format=cjs",
    "watch": "npm run build -- --watch",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.11",
    "typescript": "^5.6.3"
  }
}
